  "n_train": 100,
  "n_test": 20,
  "series_days": 60.0,
  "note": "Test labels are provided; use them only to self-score generalisation.",
  "lab_measurements": {
    "note": "Wet-chemistry titration, NOT an online sensor. Stored HOURLY in 'fostac' (N,T,2) with 'fostac_true' (N,T,2) noise-free alongside: column 0 FOS [mg HAc/L], column 1 TAC [mg CaCO3/L]. An independent titration is drawn for every hour, so an experiment selects its own sampling frequency via fostac.subsample(arr, every_days=...) instead of inheriting one fixed at write time. This makes 'how often must we measure?' answerable from the data.",
    "channels": [
      "FOS",
      "TAC"
    ],
    "units": {
      "FOS": "mg acetic-acid equivalent per L",
      "TAC": "mg CaCO3 per L"
    },
    "sample_every_days": 7.0,
    "method": "Nordmann (1977) two-endpoint titration of ONE 20 mL sample with 0.1 N H2SO4: TAC = V1*250 (start -> pH 5.0), FOS = (V2*1.66 - 0.15)*500 (pH 5.0 -> pH 4.4).",
    "why_two_channels": "FOS and TAC are two reported values but ONE measurement: the FOS leg starts where the TAC leg stops. Their errors are therefore correlated, and a plant operator reads both numbers off the titrator, so both are provided and the ratio can be formed from them.",
    "noise_model": {
      "kind": "mechanistic: the true values are converted back to titrant volumes, the volumes are perturbed, and FOS/TAC are recomputed",
      "sample_relative_sigma": 0.02,
      "endpoint_ml_sigma": 0.15,
      "burette_ml_sigma": 0.02,
      "resulting_sigma": "TAC ~2 % throughout; FOS concentration-dependent (~10 % at 1200 mg/L, ~6.7 % at 2000 mg/L, ~3 % at 5400 mg/L) because the second titration leg is short. Matches the literature 1.45 % / 6.7 %.",
      "correlation": "rises from ~0.05 (healthy, endpoint error dominates) to ~0.5 (acidified, common sample error dominates)"
    },
    "literature": [
      "Nordmann 1977",
      "Environ. Sci. Technol. 2002 (sd 1.45 % alkalinity / 6.7 % VFA)",
      "Appl. Sci. 11(24):11843 (2021)",
      "ChemEngineering 9(3):53 (2025)",
      "KTBL/VDLUFA biogas ring test"
    ],
    "known_idealisation": "The stored value is the model's TRUE VFA sum, not the empirical Nordmann proxy. The method bias of the Nordmann formula (which grows with total solids and at high VFA) is deliberately NOT modelled, so measurement noise stays separable from method error.",
    "storage": "hourly (T=1441 per series); subsample to the frequency you want",
    "default_sample_every_days": 7.0,
    "subsampling_is_exact": "Each hour carries an independent draw, so any subset of rows is a genuine measurement series at that frequency. Weekly = rows 0,168,336,... = 9 independent titrations, exactly what an operator sampling weekly would obtain.",
    "detection_limit": "A titration whose true FOS falls below the formula offset yields a non-positive value and is clipped to 0 (0.1 % of hours). Treat FOS == 0 as 'below detection' and drop it rather than fitting to it."
  }
}