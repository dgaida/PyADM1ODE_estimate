    "stable_low": "low load throughout -> FOS/TAC ~0.05-0.3 (healthy)",
    "stable_high": "long overload warmup, held high -> FOS/TAC ~0.9-1.2 (chronic)",
    "oscillating": "swinging load -> FOS/TAC sawtooth, net up (fast rise, slow/no fall)",
